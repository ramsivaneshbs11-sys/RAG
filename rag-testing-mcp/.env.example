# ── RAG Testing MCP Configuration ────────────────────────────────────
# Copy this file to .env and fill in the values.

# RAG API Connection
RAG_API_URL=http://localhost:8000
RAG_QUERY_ENDPOINT=/api/v1/query
RAG_HEALTH_ENDPOINT=/health
RAG_CACHE_STATS_ENDPOINT=/api/v1/cache/stats

# Request Settings
REQUEST_TIMEOUT=60
MAX_RETRIES=2
MAX_CONCURRENCY=5

# Evaluation Settings
EVALUATION_OUTPUT_DIR=evaluation/results
